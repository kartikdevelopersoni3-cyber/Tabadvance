<?xml version='1.0' encoding='utf-8'?>
<widget id="com.roohi.ai.os" version="1.0.4" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Roohi AI Assistant OS Layer</name>
    <description>
        Production-Ready Cloud Web App &amp; PWA for Roohi AI Assistant OS Layer.
    </description>
    <author email="support@roohi.ai" href="https://roohi.ai">
        Roohi Open Source Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="ScrollEnabled" value="true" />
    <preference name="BackupWebStorage" value="cloud" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="false" />

    <!-- VoltBuilder Build Settings -->
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="KeepRunning" value="true" />
</widget>
